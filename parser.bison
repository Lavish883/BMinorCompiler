/*
Declare token types at the top of the bison file,
causing them to be automatically generated in parser.tab.h
for use by scanner.c.
*/

%token TOKEN_EOF 0
%token TOKEN_ARRAY
%token TOKEN_AUTO
%token TOKEN_BOOLEAN_TYPE
%token TOKEN_CHAR_TYPE
%token TOKEN_DOUBLE_TYPE
%token TOKEN_ELSE
%token TOKEN_FALSE
%token TOKEN_FLOAT_TYPE
%token TOKEN_FOR
%token TOKEN_FUNCTION
%token TOKEN_IF
%token TOKEN_INTEGER_TYPE
%token TOKEN_PRINT
%token TOKEN_RETURN
%token TOKEN_STRING_TYPE
%token TOKEN_TRUE
%token TOKEN_VOID
%token TOKEN_WHILE
%token TOKEN_CHAR_LITERAL
%token TOKEN_STRING_LITERAL
%token TOKEN_INTEGER_LITERAL
%token TOKEN_DOUBLE_LITERAL
%token TOKEN_PLUS
%token TOKEN_MINUS
%token TOKEN_NOT
%token TOKEN_INCREMENT
%token TOKEN_DECREMENT
%token TOKEN_IDENT
%token TOKEN_EXPONENT
%token TOKEN_MUL
%token TOKEN_DIV
%token TOKEN_MODULO
%token TOKEN_LESS
%token TOKEN_LESS_EQUAL
%token TOKEN_GREATER
%token TOKEN_GREATER_EQUAL
%token TOKEN_EQUAL
%token TOKEN_NOT_EQUAL
%token TOKEN_AND
%token TOKEN_OR
%token TOKEN_ASSIGN
%token TOKEN_COLON
%token TOKEN_SEMICOLON
%token TOKEN_COMMA
%token TOKEN_LPAREN
%token TOKEN_RPAREN
%token TOKEN_L_SQ_BRACKET
%token TOKEN_R_SQ_BRACKET
%token TOKEN_LBRACE
%token TOKEN_RBRACE
%token TOKEN_CARRAY
%token TOKEN_HASH
%token TOKEN_ERROR

%define parse.error detailed
%{

#include <math.h>
#include <stdio.h>
#include <stdlib.h>

/*
Clunky: Manually declare the interface to the scanner generated by flex. 
*/

extern char *yytext;
extern int yylex();
extern int yyerror(const char *str );
extern const char* get_token_name(int tok);

%}

%%

/* Here is the grammar: p is the start symbol. */

p : s
	|	s p
	;

s : TOKEN_AND
	;

/*
s : TOKEN_IF e TOKEN_THEN s
	| TOKEN_IF e TOKEN_THEN s TOKEN_ELSE s
	| TOKEN_WHILE e s
	| TOKEN_BEGIN p TOKEN_END
	| TOKEN_PRINT e
	| e
	;

e : TOKEN_ID
	| TOKEN_INT
	| e TOKEN_PLUS e
	;
*/

%%


const char *get_token_name(int tok)
{
    return yysymbol_name(YYTRANSLATE(tok));
}

/*
This function will be called by bison if the parse should
encounter an error.  In principle, "str" will contain something
useful.  In practice, it often does not.
*/

int yyerror(const char *str )
{
	printf("parse error: %s\n",str);
	return 0;
}

